###############################################################################
#  WeKonnek Routing Server — Environment Variables
#  Copy to .env and fill in real values before deploying
#  Usage: cp .env.example .env && nano .env
###############################################################################

# --- Domain & SSL ---
DOMAIN=route.yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# --- PostgreSQL (PostGIS) ---
DB_USER=wekonnek
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# --- API Keys ---
# Also update nginx/api_keys.conf with matching keys
ROUTING_API_KEY=whp_routing_GENERATE_A_SECURE_KEY_HERE

# --- Service URLs (auto-configured by Docker Compose) ---
# Override only if running services externally
# OSRM_URL=http://osrm-backend:5000
# VALHALLA_URL=http://valhalla:8002
# PHOTON_URL=http://photon:2322
