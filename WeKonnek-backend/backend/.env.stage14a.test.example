# Stage 14A dedicated disposable acceptance DB (Cursor default).
# Clone a current-schema parent, then apply the Stage14A migration.
# Never point this at historical frozen DBs.
#
# Stage14A routing is dedicated. Do NOT set DATABASE_URL or
# WEKONNEK_ACCEPTANCE_DATABASE_URL to Stage13B-3B / 13B-3 / 13B-2 /
# 13B-1 / 13A regression or historical targets. Those are refused.
DATABASE_URL=postgresql://wekonnek_stage14a_cursor_test:CHANGE_ME@127.0.0.1:5432/wekonnek_stage14a_cursor_test
JWT_SECRET=dev-secret

WEKONNEK_CURRENT_SCHEMA_REGRESSION=1
WEKONNEK_ACCEPTANCE_DESTRUCTIVE_OK=1

# Optional Terra / disposable override — must already name wekonnek_stage14a_*:
# WEKONNEK_ACCEPTANCE_DATABASE_URL=postgresql://USER:PASS@127.0.0.1:5432/wekonnek_stage14a_terra_<unique>_test
# WEKONNEK_ACCEPTANCE_DESTRUCTIVE_OK=1
