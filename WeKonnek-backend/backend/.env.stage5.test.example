# Stage 5 dedicated test database (do not commit secrets)
# Copy to .env.stage5.test and fill credentials.
#
# Required:
#   DATABASE_URL pointing at database wekonnek_stage5_test
#   Prefer role wekonnek_stage5_test when CREATEROLE is available.
#
# Do NOT reuse wekonnek_stage0_test / stage1 / stage2 / stage3 / stage4.

DATABASE_URL=postgresql://wekonnek_stage5_test:CHANGE_ME@127.0.0.1:5432/wekonnek_stage5_test
JWT_SECRET=dev-secret
