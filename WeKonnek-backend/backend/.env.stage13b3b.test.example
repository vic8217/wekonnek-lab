# Stage 13B-3B disposable current-schema acceptance DB (Cursor default).
# Frozen grammar token is 13b3, so the physical DB is wekonnek_stage13b3_b_cursor_test
# (wekonnek_stage13b3b_* is not a recognized current-schema name).
#
# Do NOT expect PostgreSQL TEMPLATE wekonnek_stage13b3_test — that DB is not
# canonical infrastructure. Provision this disposable from the living parent
# wekonnek_stage13b2_test via:
#   NODE_ENV=test WEKONNEK_ACCEPTANCE_DESTRUCTIVE_OK=1 \
#     npm run db:provision-current-schema-disposable -- \
#     provision wekonnek_stage13b3_b_cursor_test
DATABASE_URL=postgresql://wekonnek_stage13b3_b_cursor_test:CHANGE_ME@127.0.0.1:5432/wekonnek_stage13b3_b_cursor_test
JWT_SECRET=dev-secret

WEKONNEK_CURRENT_SCHEMA_REGRESSION=1
WEKONNEK_ACCEPTANCE_DESTRUCTIVE_OK=1

# Optional Terra / disposable override (wins over DATABASE_URL above):
# WEKONNEK_ACCEPTANCE_DATABASE_URL=postgresql://USER:PASS@127.0.0.1:5432/wekonnek_stage13b3_terra_<unique>_test
# WEKONNEK_ACCEPTANCE_DESTRUCTIVE_OK=1
