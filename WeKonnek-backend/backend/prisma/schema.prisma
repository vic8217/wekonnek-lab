enum UserRole {
  customer
  rider
  driver
  merchant
  coordinator
  staff
  admin
}

enum MerchantStaffRole {
  owner
  manager
  cashier
  staff
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  firstName          String?  @map("first_name")
  lastName           String?  @map("last_name")
  email              String?  @unique
  phone              String   @unique
  password           String?
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  role               UserRole @default(customer)
  avatar             String?
  isActive           Boolean  @default(true) @map("is_active")
  isVerified         Boolean  @default(false) @map("is_verified")
  // Onboarding/approval status. Used mainly for riders:
  // pending → approved / rejected, plus suspended. Other roles default active.
  status             String   @default("active")
  fcmToken           String?  @map("fcm_token")
  vehicleType        String?  @map("vehicle_type")
  plateNumber        String?  @map("plate_number")
  licenseNumber      String?  @map("license_number")
  rating             Float    @default(0)
  totalDeliveries    Int      @default(0) @map("total_deliveries")
  isOnline           Boolean  @default(false) @map("is_online")
  currentLat         Float?   @map("current_lat")
  currentLng         Float?   @map("current_lng")
  walletBalance      Float    @default(0) @map("wallet_balance")
  twoFactorSecret    String?  @map("two_factor_secret")
  twoFactorEnabled   Boolean  @default(false) @map("two_factor_enabled")
  // The zone the rider selected during onboarding — a hint for the admin, not
  // an operating assignment. Admin confirms the real zone set on approval.
  preferredZoneId    String?  @map("preferred_zone_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  preferredZone            Zone?                    @relation("RiderPreferredZone", fields: [preferredZoneId], references: [id])
  zones                    RiderZone[]              @relation("RiderZones")
  addresses                Address[]
  wallet                   Wallet?
  loyaltyAccount           LoyaltyAccount?
  customerOrders           Order[]                  @relation("OrderCustomer")
  riderOrders              Order[]                  @relation("OrderRider")
  voucherRedemptions       VoucherRedemption[]
  merchantStaff            MerchantStaff[]
  bazaarListings           BazaarListing[]
  authIdentities           AuthIdentity[]
  authAuditLogs            AuthAuditLog[]
  propertyListings         PropertyListing[]        @relation("PropertyOwner")
  savedProperties          SavedProperty[]
  propertyViewings         PropertyViewingRequest[] @relation("PropertyRequester")
  propertyReports          PropertyReport[]         @relation("PropertyReporter")
  listingInquiriesReceived ListingInquiry[]         @relation("ListingInquiryOwner")
  listingInquiriesSent     ListingInquiry[]         @relation("ListingInquirySender")

  @@map("users")
}

model AuthIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
