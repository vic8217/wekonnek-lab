/// Administrative/coordinator zones. Kept separate from delivery polygons so
/// congressional coverage does not change rider pricing or routing behavior.
model ManagementZone {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  coverages               ManagementZoneCoverage[]
  coordinatorApplications CoordinatorApplication[]

  @@map("management_zones")
}

model ManagementZoneCoverage {
  id                    String   @id @default(uuid()) @db.Uuid
  zoneId                String   @map("zone_id") @db.Uuid
  regionCode            String   @map("region_code")
  regionName            String   @map("region_name")
  provinceCode          String?  @map("province_code")
  provinceName          String?  @map("province_name")
  cityMunicipalityCode  String   @map("city_municipality_code")
  cityMunicipalityName  String   @map("city_municipality_name")
  congressionalDistrict String   @map("congressional_district")
  areas                 Json     @default("[]")
  createdAt             DateTime @default(now()) @map("created_at")

  zone ManagementZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, cityMunicipalityCode, congressionalDistrict])
  @@index([cityMunicipalityCode, congressionalDistrict])
  @@map("management_zone_coverages")
}

/// Join table: a rider can serve many zones, and a zone can have many riders.
model RiderZone {
  id        String   @id @default(uuid()) @db.Uuid
  riderId   String   @map("rider_id") @db.Uuid
  zoneId    String   @map("zone_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  rider User @relation("RiderZones", fields: [riderId], references: [id], onDelete: Cascade)
  zone  Zone @relation("ZoneRiders", fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([riderId, zoneId])
  @@index([zoneId])
  @@map("rider_zones")
}

