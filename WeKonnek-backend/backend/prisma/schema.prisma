  manualOpenOverride      Boolean?  @map("manual_open_override")
  manualOverrideUpdatedAt DateTime? @map("manual_override_updated_at") @db.Timestamptz
  manualOverrideUpdatedBy String?   @map("manual_override_updated_by") @db.Uuid
  isActive                Boolean   @default(true) @map("is_active")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  merchant                   Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  staff                      MerchantStaff[]
  products                   ShopProduct[]
  inventories                ShopInventory[]
  inventoryDailyCounts       InventoryDailyCount[]
  inventoryMovements         InventoryMovement[]    @relation("InventoryMovementShop")
  incomingInventoryTransfers InventoryMovement[]    @relation("InventoryMovementTransferShop")
  orders                     WkOrder[]
  crewDevices                CrewDevice[]
  crewPairingTokens          CrewPairingToken[]
  dineInChanges              DineInChange[]
  dineInServiceRequests      DineInServiceRequest[]

  @@map("branches")
}

model MerchantStaff {
  id           Int               @id @default(autoincrement())
  merchantId   Int               @map("merchant_id")
  userId       String            @map("user_id") @db.Uuid
  branchId     Int?              @map("branch_id")
  role         MerchantStaffRole @default(staff)
  isActive     Boolean           @default(true) @map("is_active")
  displayName  String?           @map("display_name") @db.VarChar(100)
  dineInRole   String?           @map("dine_in_role") @db.VarChar(30)
  employeeCode String?           @map("employee_code") @db.VarChar(50)
  crewPinHash  String?           @map("crew_pin_hash") @db.VarChar(255)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  merchant                Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch                  Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  crewSessions            CrewDeviceSession[]
  dineInAuditLogs         DineInAuditLog[]
  assignedServiceRequests DineInServiceRequest[]

  @@unique([merchantId, userId])
  @@map("merchant_staff")
}

model MerchantFeatureGrant {
  id         String    @id @default(uuid()) @db.Uuid
  merchantId Int       @map("merchant_id")
  featureKey String    @map("feature_key") @db.VarChar(80)
  source     String    @default("add_on") @db.VarChar(30)
  limits     Json?
  isActive   Boolean   @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, featureKey, source])
  @@index([merchantId, featureKey, isActive])
  @@map("merchant_feature_grants")
}

model CrewDevice {
  id                 String              @id @default(uuid()) @db.Uuid
  merchantId         Int                 @map("merchant_id")
  shopId             Int                 @map("shop_id")
  name               String              @db.VarChar(100)
  role               String              @db.VarChar(30)
  platform           String?             @db.VarChar(80)
  tokenHash          String              @unique @map("token_hash") @db.VarChar(64)
  status             String              @default("active") @db.VarChar(20)
  registeredByUserId String              @map("registered_by_user_id") @db.Uuid
  registeredAt       DateTime            @default(now()) @map("registered_at") @db.Timestamptz
  lastSeenAt         DateTime?           @map("last_seen_at") @db.Timestamptz
  revokedAt          DateTime?           @map("revoked_at") @db.Timestamptz
  merchant           Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop               Branch              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sessions           CrewDeviceSession[]
  auditLogs          DineInAuditLog[]

  @@index([merchantId, shopId, status])
  @@map("crew_devices")
}

model CrewPairingToken {
  id              String    @id @default(uuid()) @db.Uuid
  merchantId      Int       @map("merchant_id")
  shopId          Int       @map("shop_id")
  role            String    @db.VarChar(30)
  codeHash        String    @unique @map("code_hash") @db.VarChar(64)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  merchant        Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop            Branch    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([merchantId, expiresAt])
  @@map("crew_pairing_tokens")
}

model CrewDeviceSession {
  id        String        @id @default(uuid()) @db.Uuid
  deviceId  String        @map("device_id") @db.Uuid
  staffId   Int           @map("staff_id")
  tokenHash String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz
  revokedAt DateTime?     @map("revoked_at") @db.Timestamptz
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  device    CrewDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  staff     MerchantStaff @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([deviceId, staffId])
  @@map("crew_device_sessions")
}

model DineInAuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  merchantId Int            @map("merchant_id")
  shopId     Int?           @map("shop_id")
  staffId    Int?           @map("staff_id")
  deviceId   String?        @map("device_id") @db.Uuid
  action     String         @db.VarChar(80)
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  staff      MerchantStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  device     CrewDevice?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt])
  @@map("dine_in_audit_logs")
}

model DineInChange {
  id         BigInt    @id @default(autoincrement())
  shopId     Int       @map("shop_id")
  type       String    @db.VarChar(60)
  entityId   String?   @map("entity_id") @db.VarChar(100)
  payload    Json
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  shop       Branch    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  merchantId Int?      @map("merchant_id")

  @@index([shopId, id])
  @@index([merchantId])
  @@map("dine_in_changes")
}

model DineInServiceRequest {
  id                Int            @id @default(autoincrement())
  orderId           Int            @map("order_id")
  shopId            Int            @map("shop_id")
  requestedByUserId String         @map("requested_by_user_id") @db.Uuid
  type              String         @db.VarChar(40)
  details           String?        @db.VarChar(250)
  status            String         @default("pending") @db.VarChar(20)
  assignedStaffId   Int?           @map("assigned_staff_id")
  assignedAt        DateTime?      @map("assigned_at") @db.Timestamptz
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  order             WkOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop              Branch         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  assignedStaff     MerchantStaff? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([shopId, status, createdAt])
  @@index([orderId, createdAt])
  @@index([assignedStaffId, status])
  @@map("dine_in_service_requests")
}

// ═══════════════════════════════════════════════════════
// Floor Plan / Table Layout
// ═══════════════════════════════════════════════════════

enum TableShape {
  round
  square
  rectangle
}

model FloorTable {
  id         Int        @id @default(autoincrement())
  merchantId Int        @map("merchant_id")
  label      String     @db.VarChar(100)
  shape      TableShape @default(square)
  capacity   Int        @default(4)
  posX       Float      @default(0) @map("pos_x")
  posY       Float      @default(0) @map("pos_y")
  width      Float      @default(100)
  height     Float      @default(100)
  rotation   Float      @default(0)
  isActive   Boolean    @default(true) @map("is_active")
  sortOrder  Int        @default(0) @map("sort_order")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("floor_tables")
}
