enum DiscountType {
  percentage
  fixed
}

enum VoucherStatus {
  active
  scheduled
  expired
  disabled
}

model Voucher {
  id                   String        @id @default(uuid()) @db.Uuid
  code                 String        @unique
  title                String
  description          String?
  discountType         DiscountType  @map("discount_type")
  discountValue        Float         @map("discount_value")
  maxDiscountAmount    Float?        @map("max_discount_amount")
  minOrderAmount       Float         @default(0) @map("min_order_amount")
  status               VoucherStatus @default(active)
  applicableOrderTypes String?       @map("applicable_order_types")
  storeId              String?       @map("store_id")
  maxTotalUses         Int           @default(0) @map("max_total_uses")
  maxUsesPerUser       Int           @default(1) @map("max_uses_per_user")
  totalRedemptions     Int           @default(0) @map("total_redemptions")
  startsAt             DateTime      @map("starts_at")
  expiresAt            DateTime      @map("expires_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at")

  redemptions VoucherRedemption[]

  @@index([code])
  @@map("vouchers")
}

model VoucherRedemption {
  id              String   @id @default(uuid()) @db.Uuid
  voucherId       String   @map("voucher_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  orderId         String?  @map("order_id")
  discountApplied Float    @map("discount_applied")
  redeemedAt      DateTime @default(now()) @map("redeemed_at")

  voucher Voucher @relation(fields: [voucherId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([voucherId])
  @@index([userId])
  @@index([voucherId, userId])
  @@map("voucher_redemptions")
}

enum LoyaltyTier {
  bronze
  silver
  gold
  platinum
}

model LoyaltyAccount {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @unique @map("user_id") @db.Uuid
  balance        Int        @default(0)
  lifetimePoints Int        @default(0) @map("lifetime_points")
  tier           LoyaltyTier @default(bronze)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id])
  transactions PointsTransaction[]

  @@map("loyalty_accounts")
}

enum PointsType {
  earn
  redeem
  bonus
  expired
  refund
}

model PointsTransaction {
  id           String     @id @default(uuid()) @db.Uuid
  accountId    String     @map("account_id") @db.Uuid
  type         PointsType
  points       Int
  description  String
  orderId      String?    @map("order_id")
  balanceAfter Int        @map("balance_after")
  createdAt    DateTime   @default(now()) @map("created_at")

  account LoyaltyAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([accountId, createdAt])
  @@map("points_transactions")
}

// ═══════════════════════════════════════════════════════
// Multi-Branch & Staff Management
// ═══════════════════════════════════════════════════════

model Branch {
  id              Int       @id @default(autoincrement())
  merchantId      Int       @map("merchant_id")
  name            String    @db.VarChar(255)
  address         String?   @db.Text
  city            String?   @db.VarChar(100)
  state           String?   @db.VarChar(100)
  zipCode         String?   @map("zip_code") @db.VarChar(20)
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  phone           String?   @db.VarChar(50)
  operatingHours  Json?     @map("operating_hours")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  merchant        Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  staff           MerchantStaff[]

  @@map("branches")
}

model MerchantStaff {
  id              Int               @id @default(autoincrement())
  merchantId      Int               @map("merchant_id")
  userId          String            @map("user_id") @db.Uuid
  branchId        Int?              @map("branch_id")
  role            MerchantStaffRole @default(staff)
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  merchant        Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch          Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([merchantId, userId])
  @@map("merchant_staff")
}

// ═══════════════════════════════════════════════════════
// Floor Plan / Table Layout
// ═══════════════════════════════════════════════════════

enum TableShape {
  round
  square
  rectangle
}

model FloorTable {
  id         Int        @id @default(autoincrement())
  merchantId Int        @map("merchant_id")
  label      String     @db.VarChar(100)
  shape      TableShape @default(square)
  capacity   Int        @default(4)
  posX       Float      @default(0) @map("pos_x")
  posY       Float      @default(0) @map("pos_y")
  width      Float      @default(100)
  height     Float      @default(100)
  rotation   Float      @default(0)
  isActive   Boolean    @default(true) @map("is_active")
  sortOrder  Int        @default(0) @map("sort_order")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  merchant   Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("floor_tables")
}
