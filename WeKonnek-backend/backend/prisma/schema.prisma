generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════
// WeKonnek Catalog Models
// ═══════════════════════════════════════════════════════

model Category {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(255)
  description     String?  @db.Text
  icon            String?  @db.VarChar(255)
  imageUrl        String?  @map("image_url") @db.VarChar(500)
  isActive        Boolean  @default(true) @map("is_active")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  ownerMerchantId Int?     @map("owner_merchant_id")

  subCategories      SubCategory[]
  products           Product[]
  customerPromotions CustomerPromotion[]
  staffPosts         StaffPost[]
  productCategories  ProductCategory[]
  ownerMerchant      Merchant?           @relation("MerchantOwnedCategories", fields: [ownerMerchantId], references: [id], onDelete: Cascade)

  @@index([ownerMerchantId])
  @@map("categories")
}

model SubCategory {
  id              Int      @id @default(autoincrement())
  categoryId      Int      @map("category_id")
  name            String   @db.VarChar(255)
  slug            String   @db.VarChar(255)
  description     String?  @db.Text
  icon            String?  @db.VarChar(255)
  imageUrl        String?  @map("image_url") @db.VarChar(500)
  groupName       String?  @map("group_name") @db.VarChar(100)
  isActive        Boolean  @default(true) @map("is_active")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  ownerMerchantId Int?     @map("owner_merchant_id")

  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products           Product[]
  customerPromotions CustomerPromotion[]
  productCategories  ProductCategory[]
  ownerMerchant      Merchant?           @relation("MerchantOwnedSubCategories", fields: [ownerMerchantId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([ownerMerchantId])
  @@map("sub_categories")
}

model Merchant {
  id                     Int       @id @default(autoincrement())
  merchantCode           String?   @unique @map("merchant_code") @db.VarChar(20)
  userId                 String?   @map("user_id") @db.Uuid
  name                   String    @db.VarChar(255)
  slug                   String    @unique @db.VarChar(255)
  description            String?   @db.Text
  categoryId             Int?      @map("category_id")
  subCategoryId          Int?      @map("sub_category_id")
  businessType           String?   @map("business_type") @db.VarChar(50)
  phone                  String?   @db.VarChar(20)
  email                  String?   @db.VarChar(255)
  website                String?   @db.VarChar(255)
  address                String?   @db.Text
  latitude               Decimal?  @db.Decimal(10, 8)
  longitude              Decimal?  @db.Decimal(11, 8)
  city                   String?   @db.VarChar(100)
  region                 String?   @db.VarChar(100)
  councilDistrict        String?   @map("council_district") @db.VarChar(100)
  geographicArea         String?   @map("geographic_area") @db.VarChar(150)
  state                  String?   @db.VarChar(100)
  zipCode                String?   @map("zip_code") @db.VarChar(20)
  country                String    @default("Philippines") @db.VarChar(100)
  logoUrl                String?   @map("logo_url") @db.VarChar(500)
  coverImageUrl          String?   @map("cover_image_url") @db.VarChar(500)
  isActive               Boolean   @default(true) @map("is_active")
  isVerified             Boolean   @default(false) @map("is_verified")
  status                 String    @default("active") @db.VarChar(50)
  subscriptionTier       String    @default("basic") @map("subscription_tier") @db.VarChar(50)
  subscriptionPlan       String    @default("weekly") @map("subscription_plan") @db.VarChar(50)
  subscriptionAmount     Decimal   @default(0.00) @map("subscription_amount") @db.Decimal(10, 2)
  subscriptionStatus     String    @default("active") @map("subscription_status") @db.VarChar(50)
  subscriptionStartedAt  DateTime? @map("subscription_started_at") @db.Timestamptz
  subscriptionExpiresAt  DateTime? @map("subscription_expires_at") @db.Timestamptz
  autoRenew              Boolean   @default(false) @map("auto_renew")
  paymentMethod          String?   @map("payment_method") @db.VarChar(50)
  taxClassification      String    @default("") @map("tax_classification") @db.VarChar(50)
  tin                    String?   @db.VarChar(30)
  registeredBusinessName String?   @map("registered_business_name") @db.VarChar(255)
  suspensionReason       String?   @map("suspension_reason") @db.Text
  suspensionDuration     Int?      @map("suspension_duration")
  suspendedUntil         DateTime? @map("suspended_until") @db.Timestamptz
  rating                 Decimal   @default(0.00) @db.Decimal(3, 2)
  totalReviews           Int       @default(0) @map("total_reviews")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category             MerchantCategory?      @relation(fields: [categoryId], references: [id])
  subCategory          MerchantSubCategory?   @relation(fields: [subCategoryId], references: [id])
  products             Product[]
  orders               WkOrder[]
  reservations         Reservation[]
  promotions           Promotion[]
  reviews              Review[]
  staffPosts           StaffPost[]
  subscriptionPayments SubscriptionPayment[]
  branches             Branch[]
  merchantStaff        MerchantStaff[]
  floorTables          FloorTable[]
  shopProducts         ShopProduct[]
  shopInventories      ShopInventory[]
  inventoryMovements   InventoryMovement[]
  inventoryDailyCounts InventoryDailyCount[]
  featureGrants        MerchantFeatureGrant[]
  crewDevices          CrewDevice[]
  crewPairingTokens    CrewPairingToken[]
  dineInAuditLogs      DineInAuditLog[]
  dineInChanges        DineInChange[]
  ownedCategories      Category[]             @relation("MerchantOwnedCategories")
  ownedSubCategories   SubCategory[]          @relation("MerchantOwnedSubCategories")

  @@index([userId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([city])
  @@index([latitude, longitude])
  @@index([isActive])
  @@index([status])
  @@map("merchants")
}

model MerchantCategory {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  slug         String   @unique @db.VarChar(150)
  description  String?  @db.Text
  icon         String?  @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subCategories MerchantSubCategory[]
  merchants     Merchant[]

  @@map("merchant_categories")
}

model MerchantSubCategory {
  id           Int      @id @default(autoincrement())
  categoryId   Int      @map("category_id")
  name         String   @db.VarChar(150)
  slug         String   @db.VarChar(150)
  groupName    String?  @map("group_name") @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category  MerchantCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  merchants Merchant[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("merchant_sub_categories")
}

model MerchantApplication {
  id                       Int       @id @default(autoincrement())
  merchantCode             String?   @unique @map("merchant_code") @db.VarChar(20)
  userId                   String?   @map("user_id") @db.Uuid
  businessName             String    @map("business_name") @db.VarChar(255)
  email                    String    @db.VarChar(255)
  phone                    String?   @db.VarChar(20)
  address                  String?   @db.Text
  contactName              String?   @map("contact_name") @db.VarChar(255)
  categoryName             String?   @map("category_name") @db.VarChar(150)
  subCategoryName          String?   @map("sub_category_name") @db.VarChar(150)
  cityMunicipality         String?   @map("city_municipality") @db.VarChar(100)
  barangay                 String?   @db.VarChar(150)
  councilDistrict          String?   @map("council_district") @db.VarChar(100)
  geographicArea           String?   @map("geographic_area") @db.VarChar(150)
  latitude                 Decimal?  @db.Decimal(10, 7)
  longitude                Decimal?  @db.Decimal(10, 7)
  businessDescription      String?   @map("business_description") @db.Text
  hasBranches              Boolean?  @map("has_branches")
  branchCount              Int?      @map("branch_count")
  productCount             Int?      @map("product_count")
  source                   String    @default("merchant_application") @db.VarChar(50)
  assignedCoordinatorId    String?   @map("assigned_coordinator_id") @db.Uuid
  assignedAt               DateTime? @map("assigned_at") @db.Timestamptz
  subscriptionTier         String    @default("basic") @map("subscription_tier") @db.VarChar(50)
  subscriptionPlan         String    @default("weekly") @map("subscription_plan") @db.VarChar(50)
  subscriptionAmount       Decimal   @map("subscription_amount") @db.Decimal(10, 2)
  selectedAddOnIds         String[]  @default([]) @map("selected_add_on_ids") @db.Uuid
  selectedAddOnQuantities  Json      @default("{}") @map("selected_add_on_quantities")
  temporaryPassword        String?   @map("temporary_password") @db.VarChar(100)
  recoveryKey              String?   @map("recovery_key") @db.VarChar(100)
  paymentMethod            String?   @map("payment_method") @db.VarChar(50)
  paymentProofUrl          String?   @map("payment_proof_url") @db.VarChar(500)
  businessPermitUrl        String?   @map("business_permit_url") @db.VarChar(500)
  dtiPermitUrl             String?   @map("dti_permit_url") @db.VarChar(500)
  validIdUrl               String?   @map("valid_id_url") @db.VarChar(500)
  establishmentPhotoUrl    String?   @map("establishment_photo_url") @db.VarChar(500)
  authorizedPersonPhotoUrl String?   @map("authorized_person_photo_url") @db.VarChar(500)
  businessDocumentsUrls    String[]  @map("business_documents_urls")
  status                   String    @default("pending") @db.VarChar(50)
  reviewedBy               String?   @map("reviewed_by") @db.Uuid
  reviewedAt               DateTime? @map("reviewed_at") @db.Timestamptz
  coordinatorNotes         String?   @map("coordinator_notes") @db.Text
  rejectionReason          String?   @map("rejection_reason") @db.Text
  submittedAt              DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@index([status])
  @@index([cityMunicipality, barangay])
  @@index([assignedCoordinatorId])
  @@map("merchant_applications")
}

model CoordinatorApplication {
  id                           Int       @id @default(autoincrement())
  coordinatorCode              String?   @unique @map("coordinator_code") @db.VarChar(30)
  userId                       String?   @unique @map("user_id") @db.Uuid
  fullName                     String    @map("full_name") @db.VarChar(255)
  mobileNumber                 String    @map("mobile_number") @db.VarChar(30)
  viberAccount                 String?   @map("viber_account") @db.VarChar(30)
  whatsappNumber               String?   @map("whatsapp_number") @db.VarChar(30)
  email                        String    @db.VarChar(255)
  region                       String    @db.VarChar(100)
  provinceDistrict             String    @map("province_district") @db.VarChar(100)
  cityMunicipality             String    @map("city_municipality") @db.VarChar(100)
  councilDistrict              String?   @map("council_district") @db.VarChar(100)
  barangay                     String?   @db.VarChar(150)
  preferredCoverageArea        String?   @map("preferred_coverage_area") @db.Text
  latitude                     Decimal   @db.Decimal(10, 7)
  longitude                    Decimal   @db.Decimal(10, 7)
  background                   String?   @db.VarChar(150)
  occupation                   String?   @db.VarChar(255)
  motivation                   String?   @db.Text
  monthlyCapacity              String?   @map("monthly_capacity") @db.VarChar(50)
  referred                     String?   @db.VarChar(100)
  governmentIdFrontUrl         String?   @map("government_id_front_url") @db.VarChar(500)
  governmentIdBackUrl          String?   @map("government_id_back_url") @db.VarChar(500)
  resumeUrl                    String?   @map("resume_url") @db.VarChar(500)
  supportingDocumentUrl        String?   @map("supporting_document_url") @db.VarChar(500)
  adminNotes                   String?   @map("admin_notes") @db.Text
  resetTokenHash               String?   @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpiresAt          DateTime? @map("reset_token_expires_at") @db.Timestamptz
  temporaryCredentialExpiresAt DateTime? @map("temporary_credential_expires_at") @db.Timestamptz
  status                       String    @default("pending") @db.VarChar(50)
  managementZoneId             String?   @map("management_zone_id") @db.Uuid
  submittedAt                  DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  updatedAt                    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  managementZone ManagementZone? @relation(fields: [managementZoneId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([cityMunicipality])
  @@index([managementZoneId])
  @@map("coordinator_applications")
}

model SubscriptionPayment {
  id              Int       @id @default(autoincrement())
  merchantId      Int       @map("merchant_id")
  tier            String    @db.VarChar(50)
  plan            String    @db.VarChar(50)
  amount          Decimal   @db.Decimal(10, 2)
  paymentMethod   String    @default("online") @map("payment_method") @db.VarChar(50)
  gateway         String?   @db.VarChar(50)
  status          String    @default("pending") @db.VarChar(50)
  paymentProofUrl String?   @map("payment_proof_url") @db.VarChar(500)
  paymentRef      String?   @map("payment_ref") @db.VarChar(255)
  paymentUrl      String?   @map("payment_url") @db.VarChar(500)
  periodStart     DateTime? @map("period_start") @db.Timestamptz
  periodEnd       DateTime? @map("period_end") @db.Timestamptz
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz
  rejectionReason String?   @map("rejection_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([status])
  @@map("subscription_payments")
}

model SubscriptionPlanDefinition {
  id                    String   @id @default(uuid()) @db.Uuid
  audience              String   @db.VarChar(30)
  tier                  String   @db.VarChar(50)
  fixedAmount           Decimal  @map("fixed_amount") @db.Decimal(10, 2)
  variableOrderPercent  Decimal? @map("variable_order_percent") @db.Decimal(5, 2)
  productLimit          Int?     @map("product_limit")
  features              String[] @default([])
  minimumOrders         Int?     @map("minimum_orders")
  includesInHouseRiders Boolean? @map("includes_in_house_riders")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([audience, tier])
  @@index([audience, isActive])
  @@map("subscription_plan_definitions")
}

model SubscriptionAddOnPackage {
  id          String   @id @default(uuid()) @db.Uuid
  audience    String   @default("merchant") @db.VarChar(30)
  name        String   @db.VarChar(100)
  amount      Decimal  @db.Decimal(10, 2)
  billingUnit String   @map("billing_unit") @db.VarChar(20)
  amountBasis String?  @map("amount_basis") @db.VarChar(30)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([audience, name])
  @@index([audience, isActive])
  @@map("subscription_add_on_packages")
}

model Product {
  id                 Int      @id @default(autoincrement())
  merchantId         Int      @map("merchant_id")
  name               String   @db.VarChar(255)
  description        String?  @db.Text
  notes              Json     @default("[]")
  productCode        String?  @map("product_code") @db.VarChar(100)
  sku                String?  @db.VarChar(100)
  price              Decimal? @db.Decimal(10, 2)
  quantity           Int      @default(0)
  imageUrl           String?  @map("image_url") @db.VarChar(500)
  isAvailable        Boolean  @default(true) @map("is_available")
  lowStockThreshold  Int      @default(10) @map("low_stock_threshold")
  categoryId         Int?     @map("category_id")
  subCategoryId      Int?     @map("sub_category_id")
  productType        String   @default("Retail Product") @map("product_type") @db.VarChar(50)
  brand              String?  @db.VarChar(150)
  unit               String   @default("Piece") @db.VarChar(50)
  baseSku            String?  @map("base_sku") @db.VarChar(100)
  barcode            String?  @db.VarChar(100)
  costPrice          Decimal? @map("cost_price") @db.Decimal(10, 2)
  sellingPrice       Decimal? @map("selling_price") @db.Decimal(10, 2)
  discountPrice      Decimal? @map("discount_price") @db.Decimal(10, 2)
  hasVariants        Boolean  @default(false) @map("has_variants")
  trackInventory     Boolean  @default(false) @map("track_inventory")
  availabilityStatus String   @default("Available") @map("availability_status") @db.VarChar(30)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  merchant             Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id])
  subCategory          SubCategory?          @relation(fields: [subCategoryId], references: [id])
  orderItems           OrderItem[]
  reviews              Review[]
  productCategories    ProductCategory[]
  options              ProductOption[]
  variants             ProductVariant[]
  shopProducts         ShopProduct[]
  shopInventories      ShopInventory[]
  inventoryMovements   InventoryMovement[]
  inventoryDailyCounts InventoryDailyCount[]

  @@index([merchantId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@map("products")
}

model ProductOption {
  id        Int                  @id @default(autoincrement())
  productId Int                  @map("product_id")
  name      String               @db.VarChar(100)
  position  Int                  @default(0)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id       Int                         @id @default(autoincrement())
  optionId Int                         @map("option_id")
  value    String                      @db.VarChar(150)
  position Int                         @default(0)
  option   ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantOptionValue[]

  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id                   Int                         @id @default(autoincrement())
  productId            Int                         @map("product_id")
  sku                  String                      @unique @db.VarChar(100)
  barcode              String?                     @db.VarChar(100)
  price                Decimal?                    @db.Decimal(10, 2)
  imageUrl             String?                     @map("image_url") @db.VarChar(500)
  isActive             Boolean                     @default(true) @map("is_active")
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  product              Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues         ProductVariantOptionValue[]
  shopInventories      ShopInventory[]
  inventoryMovements   InventoryMovement[]
  inventoryDailyCounts InventoryDailyCount[]
  orderItems           OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductVariantOptionValue {
  variantId     Int                @map("variant_id")
  optionValueId Int                @map("option_value_id")
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("product_variant_option_values")
}

model ProductCategory {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  categoryId    Int      @map("category_id")
  subCategoryId Int?     @map("sub_category_id")
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)

  @@unique([productId, categoryId, subCategoryId])
  @@index([productId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@map("product_categories")
}

model ShopProduct {
  id                Int      @id @default(autoincrement())
  merchantId        Int      @map("merchant_id")
  shopId            Int      @map("shop_id")
  productId         Int      @map("product_id")
  isEnabled         Boolean  @default(true) @map("is_enabled")
  priceOverride     Decimal? @map("price_override") @db.Decimal(10, 2)
  isOnMenu          Boolean  @default(true) @map("is_on_menu")
  menuVisible       Boolean  @default(true) @map("menu_visible")
  menuDescription   String?  @map("menu_description") @db.Text
  menuBadge         String?  @map("menu_badge") @db.VarChar(20)
  menuFeatured      Boolean  @default(false) @map("menu_featured")
  menuCategory      String?  @map("menu_category") @db.VarChar(120)
  menuDisplayOrder  Int      @default(0) @map("menu_display_order")
  menuCategoryOrder Int      @default(0) @map("menu_category_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop     Branch   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId])
  @@index([merchantId, shopId])
  @@index([shopId, isOnMenu, menuVisible])
  @@index([shopId, menuCategoryOrder, menuDisplayOrder])
  @@map("shop_products")
}

model ShopInventory {
  id               Int      @id @default(autoincrement())
  merchantId       Int      @map("merchant_id")
  shopId           Int      @map("shop_id")
  productId        Int      @map("product_id")
  variantId        Int?     @map("variant_id")
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  reorderLevel     Int      @default(0) @map("reorder_level")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shop     Branch          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

