# Stage 12 shared acceptance DB (Cursor default).
DATABASE_URL=postgresql://wekonnek_stage12_test:CHANGE_ME@127.0.0.1:5432/wekonnek_stage12_test
JWT_SECRET=dev-secret

# Destructive acceptance opt-in (required by harness safety guard).
# loadStageTestEnv also sets this for .env.stage12.test when unset.
WEKONNEK_ACCEPTANCE_DESTRUCTIVE_OK=1

# Optional Terra / disposable override (wins over DATABASE_URL above):
# WEKONNEK_ACCEPTANCE_DATABASE_URL=postgresql://USER:PASS@127.0.0.1:5432/wekonnek_stage12_terra_final_test
# WEKONNEK_ACCEPTANCE_DESTRUCTIVE_OK=1
