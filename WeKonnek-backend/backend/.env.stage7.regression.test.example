# Stage 7 disposable CURRENT-SCHEMA regression database (do not commit secrets)
# Copy to .env.stage7.regression.test and fill credentials.
#
# Required:
#   DATABASE_URL pointing at database wekonnek_stage7_regression_test
#
# This is NOT a historical acceptance DB.
# Do NOT point at wekonnek_stage0..stage6 / stage5b historical DBs.
#
# Usage:
#   WEKONNEK_CURRENT_SCHEMA_REGRESSION=1 npx jest ...

DATABASE_URL=postgresql://victor@127.0.0.1:5432/wekonnek_stage7_regression_test?host=/var/run/postgresql
JWT_SECRET=dev-secret
RIDER_CUSTODY_HANDOFF_TTL_SECONDS=300
RETURN_HANDOFF_TTL_SECONDS=300
DELIVERY_HANDOFF_TTL_SECONDS=300
PICKUP_HANDOFF_TTL_SECONDS=300
