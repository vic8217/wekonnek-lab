# Stage 10 current-schema regression DB (do not commit secrets)
# Copy to .env.stage10.regression.test when WEKONNEK_CURRENT_SCHEMA_REGRESSION=1.
#
# Required:
#   DATABASE_URL pointing at database wekonnek_stage10_regression_test

DATABASE_URL=postgresql://wekonnek_stage10_regression_test:CHANGE_ME@127.0.0.1:5432/wekonnek_stage10_regression_test
JWT_SECRET=dev-secret
WEKONNEK_CURRENT_SCHEMA_REGRESSION=1
