# ─── Database (Prisma) ────────────────────────
# Local development (replace YOUR_USERNAME with your macOS username)
DATABASE_URL=postgresql://YOUR_USERNAME@localhost:5432/wekonnek
# DigitalOcean (uncomment for remote)
# DATABASE_URL=postgresql://wekonnek_user:PASSWORD@host:25060/wekonnek?sslmode=require

# ─── Server ──────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
# Public API origin that receives OAuth provider callbacks. Use HTTPS outside
# local development; this is the API host, not the Admin or customer UI host.
PUBLIC_API_URL=http://localhost:3000

# ─── Auth ────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRY=7d
OTP_HASH_SECRET=CHANGE_ME_TO_A_DIFFERENT_STRONG_RANDOM_SECRET

# Customer OAuth (callback URLs must point to /api/auth/oauth/{provider}/callback)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/oauth/facebook/callback
APPLE_CLIENT_ID=your_apple_service_id
APPLE_CLIENT_SECRET=your_generated_apple_client_secret
APPLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/apple/callback

# ─── Redis ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── SMS / OTP ───────────────────────────────
SMS_PROVIDER=console
VIBER_BOT_TOKEN=your_viber_bot_token
VIBER_SENDER_NAME=WeKonnek
VIBER_API_URL=https://chatapi.viber.com/pa/send_message
# Twilio (international)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=+14155238886
# Semaphore (Philippines)
SEMAPHORE_API_KEY=your_semaphore_api_key

# ─── Payment Gateways ───────────────────────
PAYMONGO_SECRET_KEY=your_paymongo_secret
MAYA_API_KEY=your_maya_api_key
XENDIT_SECRET_KEY=your_xendit_secret

# PayCools (UAT). Never expose these values to the frontend.
# CALLBACK_SECRET is an admin-readiness checkbox only. Callback verification
# requires the PayCools RSA public key, not a shared secret header.
# PAYCOOLS_UAT_BASE_URL=
# PAYCOOLS_UAT_APP_ID=
# PAYCOOLS_UAT_PRIVATE_KEY_BASE64=
# PAYCOOLS_UAT_CALLBACK_SECRET=
# PAYCOOLS_UAT_CALLBACK_PUBLIC_KEY_BASE64=
# PAYCOOLS_UAT_CHANNEL_CODE=QRPH_DYNAMIC_QR
# PAYCOOLS_UAT_HEALTHCHECK_URL=
# PAYCOOLS_UAT_IP_WHITELIST_REQUIRED=false

# Daily merchant subscription billing (Asia/Manila). Catch-up re-runs today's
# unpaid billing only; it does not back-charge historical days.
# SUBSCRIPTION_DAILY_BILLING_CRON=5 0 * * *
# SUBSCRIPTION_DAILY_BILLING_CATCHUP_CRON=5 * * * *
# SUBSCRIPTION_DAILY_BILLING_TZ=Asia/Manila

# ─── Firebase (Push Notifications) ──────────
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_escaped_private_key"
# Property listings
PROPERTY_REQUIRE_APPROVAL=false
PROPERTY_MAX_PHOTOS=20

# ─── DigitalOcean Spaces media storage ─────────
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_CDN_URL=
MEDIA_ENVIRONMENT=lab
MEDIA_MAX_UPLOAD_MB=15
MEDIA_CLEANUP_GRACE_DAYS=7

# ─── Visual Search (development / POC) ────────
# Customer Visual Search remains disabled unless explicitly enabled after a POC.
VISUAL_SEARCH_ENABLED=false
# `mock` is local and deterministic. A real provider is never selected implicitly.
VISUAL_SEARCH_PROVIDER=mock
# Required only after a specific provider adapter and its documented variables exist.
# Do not add provider credentials to this file.
# VISUAL_SEARCH_<PROVIDER>_API_KEY=
# VISUAL_SEARCH_<PROVIDER>_MODEL=
# VISUAL_SEARCH_<PROVIDER>_ENDPOINT=
# Vertex POC uses Application Default Credentials (ADC), not an API key. Keep
# GOOGLE_APPLICATION_CREDENTIALS outside this repository if local ADC is not used.
VISUAL_SEARCH_VERTEX_PROJECT_ID=
VISUAL_SEARCH_VERTEX_LOCATION=
VISUAL_SEARCH_VERTEX_MODEL=multimodalembedding@001
# Initial POC only; supported values are 128, 256, 512, and 1408.
VISUAL_SEARCH_VERTEX_DIMENSION=512
VISUAL_SEARCH_VERTEX_TIMEOUT_MS=15000
# Network benchmarks are denied by default to prevent unexpected provider charges.
VISUAL_SEARCH_ALLOW_EXTERNAL_BENCHMARK=false
# A network benchmark with more queries refuses to run unless explicitly overridden.
VISUAL_SEARCH_BENCHMARK_MAX_QUERIES=100
# Development POC guard: refuse a Vertex run estimated above this amount unless
# VISUAL_SEARCH_ALLOW_COST_OVERRIDE=true is deliberately set outside this file.
VISUAL_SEARCH_BENCHMARK_MAX_COST_USD=1
