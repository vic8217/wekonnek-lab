# Stage 7 dedicated test database (do not commit secrets)
# Copy to .env.stage7.test and fill credentials.
#
# Required:
#   DATABASE_URL pointing at database wekonnek_stage7_test
#
# Do NOT reuse wekonnek_stage6_test / stage5b / stage5 / stage4 / stage3 / stage2 / stage1 / stage0.

DATABASE_URL=postgresql://wekonnek_stage7_test:CHANGE_ME@127.0.0.1:5432/wekonnek_stage7_test
JWT_SECRET=dev-secret
RIDER_CUSTODY_HANDOFF_TTL_SECONDS=300
