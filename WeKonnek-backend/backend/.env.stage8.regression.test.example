# Stage 8 disposable current-schema regression database (do not commit secrets)
# Copy to .env.stage8.regression.test when WEKONNEK_CURRENT_SCHEMA_REGRESSION=1.
#
# Required:
#   DATABASE_URL pointing at database wekonnek_stage8_regression_test
#
# Do NOT reuse historical acceptance DBs or wekonnek_stage7_*.

DATABASE_URL=postgresql://wekonnek_stage8_test:CHANGE_ME@127.0.0.1:5432/wekonnek_stage8_regression_test
JWT_SECRET=dev-secret
WEKONNEK_CURRENT_SCHEMA_REGRESSION=1
