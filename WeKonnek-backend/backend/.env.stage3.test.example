# Stage 3 dedicated test database (do not commit secrets)
# Copy to .env.stage3.test and fill credentials.
#
# Required:
#   DATABASE_URL=postgresql://wekonnek_stage3_test:PASSWORD@127.0.0.1:5432/wekonnek_stage3_test
#
# Stage 3A postgres specs require database name wekonnek_stage3_test.
# Do NOT reuse wekonnek_stage0_test / wekonnek_stage1_test / wekonnek_stage2_test.

DATABASE_URL=postgresql://wekonnek_stage3_test:CHANGE_ME@127.0.0.1:5432/wekonnek_stage3_test
PICKUP_HANDOFF_TTL_SECONDS=300
