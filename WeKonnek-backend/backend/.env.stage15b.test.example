# Stage15B dedicated disposable acceptance DB (Cursor default).
# Never point this at frozen Stage3–Stage15A historical databases.
DATABASE_URL=postgresql://wekonnek_stage15b_cursor_test:CHANGE_ME@127.0.0.1:5432/wekonnek_stage15b_cursor_test
JWT_SECRET=dev-secret

WEKONNEK_ACCEPTANCE_DESTRUCTIVE_OK=1

# Optional explicit override (wins over DATABASE_URL above):
# WEKONNEK_ACCEPTANCE_DATABASE_URL=postgresql://USER:PASS@127.0.0.1:5432/wekonnek_stage15b_cursor_test
# WEKONNEK_ACCEPTANCE_DESTRUCTIVE_OK=1
#
# Frozen historical suites (Stage12) against a current-schema Stage15B DB:
# WEKONNEK_ACCEPTANCE_DB_OVERRIDE=1
# WEKONNEK_ACCEPTANCE_DATABASE_URL=postgresql://USER:PASS@127.0.0.1:5432/wekonnek_stage15b_terra_regression_test
# Historical .env.stage12.test must not replace that URL. Missing URL fails closed.
